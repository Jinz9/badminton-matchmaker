# Cấu hình Firebase Client cho Expo Mobile App
# Sao chép file này thành .env hoặc .env.local và điền giá trị thật

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment12345
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=badminton-danang.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=badminton-danang
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=badminton-danang.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Nguồn dữ liệu ứng dụng: mock | firebase
EXPO_PUBLIC_DATA_SOURCE=mock

# Cờ bật kết nối Firebase Emulator khi dev (true / false)
# (Hỗ trợ cả EXPO_PUBLIC_USE_FIREBASE_EMULATOR và EXPO_PUBLIC_USE_EMULATOR)
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true

# Địa chỉ IP máy tính host chạy Emulator:
# - Android Emulator: 10.0.2.2
# - iOS Simulator: localhost hoặc 127.0.0.1
# - Điện thoại thật (Expo Go): Địa chỉ IP LAN (ví dụ 192.168.1.50)
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2
