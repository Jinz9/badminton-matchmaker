{
  "name": "badminton-matchmaker-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions cho Hệ thống Ghép đội Cầu lông Đà Nẵng",
  "main": "lib/index.js",
  "scripts": {
    "prebuild": "node ../scripts/sync-domain.js",
    "build": "npm run prebuild && tsc",
    "pretest": "npm run prebuild",
    "test": "jest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "private": true
}
