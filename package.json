{
  "name": "badminton-matchmaker",
  "version": "1.0.0",
  "description": "Hệ thống ghép đội và cân bằng kèo cầu lông (Mobile App - Đà Nẵng)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:ui": "jest --config jest.ui.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "sync:domain": "node scripts/sync-domain.js",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions run test",
    "test:rules": "npx firebase --project=demo-badminton emulators:exec --only=firestore scripts\\run-rules-test.cmd",
    "emulators:start": "node scripts/sync-domain.js && firebase emulators:start",
    "test:all": "npx jest --testPathIgnorePatterns=test/firebase --runInBand && npm run test:ui -- --runInBand",
    "seed": "npx ts-node scripts/seed-placeholder.ts",
    "set-admin": "node scripts/set-admin.js",
    "postinstall": "node scripts/patch-expo-cli.js"
  },
  "keywords": [
    "badminton",
    "expo",
    "firebase",
    "matching",
    "balancing",
    "elo"
  ],
  "author": "DAO DUY NHAT & NGUYEN DUC DAT",
  "license": "ISC",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "jest": "^29.7.0",
    "jest-expo": "^58.0.14",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@types/react": "~19.3.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "firebase": "^13.3.0",
    "query-string": "^7.1.3",
    "react": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0"
  }
}
