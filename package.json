{
  "name": "badminton-matchmaker",
  "version": "1.0.0",
  "description": "Hệ thống ghép đội và cân bằng kèo cầu lông (Mobile App - Đà Nẵng)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "sync:domain": "node scripts/sync-domain.js",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions run test",
    "test:rules": "npx firebase --project=demo-badminton emulators:exec --only=firestore scripts\\run-rules-test.cmd",
    "emulators:start": "node scripts/sync-domain.js && firebase emulators:start",
    "test:all": "npm test",
    "seed": "npx ts-node scripts/seed-placeholder.ts",
    "set-admin": "node scripts/set-admin.js"
  },
  "keywords": [
    "badminton",
    "expo",
    "firebase",
    "matching",
    "balancing",
    "elo"
  ],
  "author": "DAO DUY NHAT & NGUYEN DUC DAT",
  "license": "ISC",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@types/react": "~18.3.12",
    "expo": "~52.0.49",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-keep-awake": "~14.0.3",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.22",
    "react": "^18.3.1",
    "react-native": "^0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0"
  }
}
